{
  "name": "ogre",
  "version": "7.0.0",
  "description": "ogr2ogr web client",
  "keywords": [
    "GIS",
    "GeoJSON",
    "ogr2ogr"
  ],
  "homepage": "http://github.com/wavded/ogre",
  "author": "Marc Harter <wavded@gmail.com>",
  "repository": {
    "type": "git",
    "url": "http://github.com/wavded/ogre.git"
  },
  "bin": {
    "ogre": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "type": "module",
  "scripts": {
    "prepack": "bun run build",
    "build": "bun build ./cli.ts --target=node --format=esm --packages=external --loader .html:text --outfile=dist/cli.js",
    "start": "bun run build && node dist/cli.js",
    "test": "bun test --timeout 30000",
    "lint": "bun check && oxlint . && bun fmt --check",
    "fix": "oxlint --fix . && bun fmt"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.19",
    "ogr2ogr": "8.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
