{
  "name": "ogre",
  "version": "5.0.4",
  "description": "ogr2ogr web client",
  "keywords": [
    "GIS",
    "GeoJSON",
    "ogr2ogr"
  ],
  "homepage": "http://github.com/wavded/ogre",
  "author": "Marc Harter <wavded@gmail.com>",
  "repository": {
    "type": "git",
    "url": "http://github.com/wavded/ogre.git"
  },
  "bin": {
    "ogre": "dist/cli.cjs"
  },
  "type": "module",
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "start": "pnpm build && dist/cli.cjs",
    "test": "vitest run --silent",
    "lint": "tsc --noEmit && oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31",
    "ogr2ogr": "7.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "tsdown": {
    "clean": true,
    "entry": [
      "cli.ts"
    ],
    "format": "cjs",
    "loader": {
      ".html": "text"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
