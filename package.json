{
  "name": "ogre",
  "version": "6.0.0",
  "description": "ogr2ogr web client",
  "keywords": [
    "GIS",
    "GeoJSON",
    "ogr2ogr"
  ],
  "homepage": "http://github.com/wavded/ogre",
  "author": "Marc Harter <wavded@gmail.com>",
  "repository": {
    "type": "git",
    "url": "http://github.com/wavded/ogre.git"
  },
  "bin": {
    "ogre": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prepack": "bun run build",
    "build": "bun build ./cli.ts --target=node --format=cjs --packages=external --loader .html:text --outfile=dist/cli.cjs",
    "start": "bun run build && node dist/cli.cjs",
    "test": "vitest run --silent",
    "lint": "tsc --noEmit && oxlint . && bun fmt --check",
    "fix": "oxlint --fix . && bun fmt"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "ogr2ogr": "7.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.82.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
